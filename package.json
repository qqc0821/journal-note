{
  "name": "journal-note",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet local journal for macOS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "ELECTRON_RUN_AS_NODE=1 electron --test tests/*.test.cjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run build && electron-builder --mac --dir",
    "test:ui": "node tests/electron-smoke.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "better-sqlite3": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "@playwright/test": "^1.56.0"
  },
  "build": {
    "appId": "com.journalnote.desktop",
    "productName": "Journal Note",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "identity": null
    },
    "directories": {
      "output": "release"
    }
  }
}
